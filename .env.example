# Copy this file to .env and replace the JWT key before starting the stack.
POSTGRES_PASSWORD=skillsync
DATABASE_URL=postgresql://skillsync:skillsync@postgres:5432/skillsync
JWT_SECRET_KEY=replace_with_a_random_64_character_secret_before_starting
FRONTEND_ORIGIN=http://localhost:3000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
